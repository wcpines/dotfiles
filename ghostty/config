# --- Theme ---
# Run `ghostty +list-themes`, then press `w` to select a theme.
# The picker writes the selected theme to this optional included file.
theme = solarized-light.ghostty
config-file = ?auto/theme.ghostty

# Open the native theme picker in the focused terminal.
command-palette-entry = title:"Pick Ghostty Theme",description:"Open the native Ghostty theme picker.",action:"text:ghostty +list-themes\r"

cursor-style = block
shell-integration-features = no-cursor

# Make window chrome follow macOS light/dark as well
window-theme = system

# --- Font (tweak to taste) ---
# font-family = JetBrainsMono Nerd Font
font-family = FiraCode Nerd Font Mono
font-size = 20
bold-color = bright

# --- Scrollback and scrollbars ---
# 10 MiB scrollback per terminal surface. Ghostty measures this in bytes.
# scrollback-limit = 10485760

# Native macOS scrollbars ("system" respects system scrollbar settings)
scrollbar = system

# --- Tabs and splits behavior ---
# Save/restore windows, tabs, and splits between launches
window-save-state = always

# Make new windows inherit the previously focused window's directory
window-inherit-working-directory = true

# --- Quality-of-life ---
copy-on-select = clipboard
mouse-hide-while-typing = true
